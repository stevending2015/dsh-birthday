{
  "name": "dsh-birthday",
  "version": "0.1.0",
  "description": "DSH plugin: multi-calendar birthday library (Gregorian / Lunar / Islamic / Hebrew) with pluggable adapters",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client",
    "client",
    "src",
    "docs",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node scripts/bundle-client.mjs",
    "build:all": "npm run build && npm run build:client",
    "prepack": "npm run build:all",
    "prepare": "npm run build:all",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.test.json",
    "verify": "node scripts/verify-integration.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "audit:private": "node scripts/audit-private-data.mjs",
    "check": "npm run lint && npm run test && npm run build:all && npm run verify && npm run verify:client && npm run verify:package"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "birthday",
    "calendar",
    "lunar",
    "islamic",
    "hebrew"
  ],
  "license": "MIT",
  "author": "dsh-birthday contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevending2015/dsh-birthday.git"
  },
  "homepage": "https://github.com/stevending2015/dsh-birthday#readme",
  "bugs": {
    "url": "https://github.com/stevending2015/dsh-birthday/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "dependencies": {
    "lunar": "^2.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
